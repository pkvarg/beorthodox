---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import HeroIconBoard from "@/components/content/HeroIconBoard.astro";
import LibraryMenu from "@/components/content/LibraryMenu.astro";
import ChurchScene from "@/components/section/ChurchScene.astro";
---

<Layout theme="dark">
  <Section paddingTop="even" paddingBottom="small">
    <HeroIconBoard
      title="Be Orthodox"
      pronunciation="or·tho·dox /ˈɔːθədɒks/"
      definition="Holding the right belief. Of the usual, expected kind; done in the normal way."
      reference="John 4:24"
    >
      God is a Spirit: and they that worship him must worship him in
      <strong>spirit</strong> and in <strong>truth</strong>.
    </HeroIconBoard>
  </Section>
  <ChurchScene />
  <Section paddingTop="small" paddingBottom="medium">
    <ContentWrapper centered={true}>
      <Heading variant="h3" tag="h2" maxWidth={30}>
        Everyone wants to be right
      </Heading>
      <Paragraph variant="large" maxWidth={78}>
        No one sets out to believe a lie. Each of us needs to know that what we
        hold is true, and none of us wants to find out that we were deceived.
      </Paragraph>
      <Paragraph variant="large" maxWidth={78}>
        We are not calling anyone to Eastern Orthodoxy, Roman Catholicism or
        Protestantism. We want simply to be Christians, disciples of Christ. We
        do not argue for a religion, a system or an organization. What we care
        about is to be in spirit and in truth.
      </Paragraph>
    </ContentWrapper>
  </Section>
  <Section id="library" paddingTop="none" paddingBottom="large" gap="6">
    <ContentWrapper centered={true}>
      <Heading variant="h3" tag="h2">
        Library
      </Heading>
    </ContentWrapper>
    <LibraryMenu />
  </Section>
</Layout>
