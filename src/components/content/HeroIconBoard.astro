---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Title set on one row across the board. */
  title: string;
  /** Syllables and phonetic spelling of the defined word. */
  pronunciation: string;
  /** Dictionary definition of the word. */
  definition: string;
  /** Source of the quoted verse. */
  reference: string;
};

const {
  render = true,
  title,
  pronunciation,
  definition,
  reference,
  class: className,
  ...rest
} = Astro.props;

const verse = await slotContent(Astro.slots);
---

{render && title && (
  <div class:list={["hero-icon-board_wrap", className]} {...rest}>
    <div class="hero-icon-board_field">
      <h1 class="hero-icon-board_title text-style-display">{title}</h1>
      <div class="hero-icon-board_entry">
        <p class="hero-icon-board_pronunciation">{pronunciation}</p>
        <p class="hero-icon-board_definition">{definition}</p>
        {verse && (
          <blockquote class="hero-icon-board_verse">
            <p class="hero-icon-board_verse-text">
              <Fragment set:html={verse} />
            </p>
            <cite class="hero-icon-board_reference">{reference}</cite>
          </blockquote>
        )}
      </div>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .hero-icon-board_wrap {
      width: 100%;
      max-width: 60rem;
      margin-inline: auto;
      padding: clamp(0.875rem, 2.6vw, 2.125rem);
      background-color: var(--gold-700);
      color: var(--ink-900);
      border: 0.1875rem solid var(--cinnabar-600);
      outline: var(--border-width) solid var(--gold-900);
      outline-offset: -0.5rem;
    }

    .hero-icon-board_field {
      container-type: inline-size;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 4.5vw, 3.75rem);
      padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4.5rem);
      text-align: center;
      background-image: radial-gradient(
        120% 90% at 30% 10%,
        var(--gold-300) 0%,
        var(--gold-500) 38%,
        var(--gold-600) 100%
      );
      box-shadow:
        inset 0 0.1875rem 0.625rem rgb(70 45 0 / 0.45),
        inset 0 -0.125rem 0.375rem rgb(255 240 190 / 0.5);
    }

    .hero-icon-board_title {
      margin-top: clamp(1.5rem, 3vw, 2.5rem);
      font-size: min(13cqw, 6rem);
      line-height: 0.92;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    .hero-icon-board_entry {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      width: 100%;
      padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
      margin-bottom: clamp(1rem, 3vw, 2rem);
      border-top: 0.125rem solid var(--cinnabar-600);
    }

    .hero-icon-board_pronunciation {
      font-family: var(--font-gentium-phonetic), var(--primary-family);
      font-size: clamp(1.375rem, 2vw, 1.75rem);
      line-height: 1.3;
    }

    .hero-icon-board_definition {
      font-size: clamp(1.25rem, 1.8vw, 1.5rem);
      line-height: 1.45;
      text-wrap: balance;
    }

    .hero-icon-board_verse {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      margin-top: clamp(1.25rem, 3vw, 2.25rem);
    }

    .hero-icon-board_verse-text {
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      font-style: italic;
      line-height: 1.25;
      text-wrap: balance;
      & strong {
        font-size: 1.3em;
        font-style: normal;
        font-weight: var(--primary-bold);
        color: var(--cinnabar-700);
      }
    }

    .hero-icon-board_reference {
      font-size: clamp(1.125rem, 1.7vw, 1.5rem);
      font-style: normal;
      font-weight: var(--primary-bold);
      color: var(--dark-900);
    }
  }
</style>
